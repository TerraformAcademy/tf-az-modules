                "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'id-entra-secret-monitor')]"
              }
            }
          },
          "userAssignedIdentities": {
            "value": {
              "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'id-entra-secret-monitor'))]": {}
            }
          },
          "state": {
